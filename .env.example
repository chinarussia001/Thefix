# Generate a unique extension-to-backend bearer token with: openssl rand -hex 32
LOVARPM_API_TOKEN=
# Configure secrets only in this server-side environment.
VYCE_API_KEY=
GITHUB_TOKEN=

LOVARPM_HOST=127.0.0.1
LOVARPM_PORT=4173
LOVARPM_DATA_DIR=./backend/data
LOVARPM_WORKSPACE_DIR=./backend/workspaces
LOVARPM_EXECUTION_IMAGE=node:22-bookworm
LOVARPM_DOCKER_NETWORK=bridge
LOVARPM_MAX_TASK_MINUTES=30
LOVARPM_MAX_TOOL_CALLS=30
LOVARPM_MAX_TASK_TOKENS=500000
LOVARPM_MAX_CONCURRENT_TASKS=1
